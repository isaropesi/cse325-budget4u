@page "/not-found"
@layout MainLayout
@using budget4u.Components.Layout

<PageTitle>Page Not Found - Budget4U</PageTitle>

<div class="d-flex align-items-center justify-content-center text-center" style="min-height:60vh;">
    <div>
        <div style="font-size:5rem;font-weight:700;background:linear-gradient(135deg,var(--accent-primary),var(--accent-secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1;">404</div>
        <h2 class="mt-3 mb-2">Page Not Found</h2>
        <p class="text-secondary mb-4">Sorry, the page you are looking for doesn't exist or has been moved.</p>
        <a href="/" class="btn btn-primary px-4">
            <i class="bi bi-house-fill me-2"></i>Back to Dashboard
        </a>
    </div>
</div>