@page "/transactions/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using budget4u.Data
@using budget4u.Data.Models
@using System.Security.Claims
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Edit Transaction - Budget4U</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h2 class="card-title h4 mb-4">Edit Transaction</h2>

                @if (errorMessage != null)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                @if (transaction == null)
                {
                    <div class="text-center py-4 text-secondary">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p>Loading transaction...</p>
                    </div>
                }
                else if (categories == null || !categories.Any())
                {
                    <div class="alert alert-warning">
                        No categories found. <a href="/categories/create" class="alert-link">Create a category first</a>.
                    </div>
                }
                else
                {
                    <EditForm Model="transaction" OnValidSubmit="HandleSubmit" FormName="editTransaction">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label for="amount" class="form-label fw-medium">Amount ($)</label>
                            <InputNumber id="amount" class="form-control form-control-lg" @bind-Value="transaction.Amount" placeholder="0.00" onfocus="this.select()" />
                            <ValidationMessage For="() => transaction.Amount" class="text-danger mt-1 small" />
                        </div>

                        <div class="mb-3">
                            <label for="date" class="form-label fw-medium">Date</label>
                            <InputDate id="date" class="form-control form-control-lg" @bind-Value="transaction.Date" />
                            <ValidationMessage For="() => transaction.Date" class="text-danger mt-1 small" />
                        </div>

                        <div class="mb-3">
                            <label for="category" class="form-label fw-medium">Category</label>
                            <InputSelect id="category" class="form-select form-select-lg" @bind-Value="transaction.CategoryId">
                                <option value="0">Select a category...</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name (@cat.Type)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => transaction.CategoryId" class="text-danger mt-1 small" />
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label fw-medium">Description (Optional)</label>
                            <InputText id="description" class="form-control form-control-lg" @bind-Value="transaction.Description" placeholder="e.g. Weekly groceries" />
                            <ValidationMessage For="() => transaction.Description" class="text-danger mt-1 small" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a href="/transactions" class="btn btn-light btn-lg">Cancel</a>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private Transaction? transaction { get; set; }
    private List<Category>? categories;
    private string? userId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            if (transaction == null)
            {
                // Load the transaction (verifying ownership)
                transaction = await DbContext.Transactions
                    .FirstOrDefaultAsync(t => t.Id == Id && t.UserId == userId);

                if (transaction == null)
                {
                    errorMessage = "Transaction not found or you do not have permission to edit it.";
                    return;
                }
            }

            // Load the user's categories
            categories = await DbContext.Categories
                .Where(c => c.UserId == userId)
                .OrderBy(c => c.Name)
                .ToListAsync();
        }
    }

    private async Task HandleSubmit()
    {
        if (userId != null && transaction != null && transaction.CategoryId != 0)
        {
            try
            {
                transaction.Id = Id;
                transaction.UserId = userId;
                DbContext.Transactions.Update(transaction);
                await DbContext.SaveChangesAsync();
                NavigationManager.NavigateTo("/transactions");
            }
            catch (Exception ex)
            {
                errorMessage = $"An error occurred while saving: {ex.Message}";
            }
        }
        else if (transaction?.CategoryId == 0)
        {
            errorMessage = "Please select a valid category.";
        }
    }
}
