@page "/categories"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using budget4u.Data
@using budget4u.Data.Models
@using System.Security.Claims
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Categories - Budget4U</PageTitle>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">My Categories</h1>
    <a href="/categories/create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Category
    </a>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-warning alert-dismissible mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
    </div>
}

@if (categories == null)
{
    <p><em>Loading...</em></p>
}
else if (!categories.Any())
{
    <div class="alert alert-info">
        You haven't created any categories yet. Create one to start tracking your budget!
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Budget Limit</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categories)
                    {
                        <tr>
                            <td class="align-middle fw-medium">@category.Name</td>
                            <td class="align-middle">
                                <span class="badge @(category.Type == "Income" ? "bg-success" : "bg-danger")">
                                    @category.Type
                                </span>
                            </td>
                            <td class="align-middle">
                                @(category.BudgetLimit > 0 ? category.BudgetLimit.ToString("C") : "No limit")
                            </td>
                            <td class="text-end align-middle">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/categories/edit/@category.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDelete(category.Id, category.Name)"
                                            title="Delete category">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Confirmation Modal *@
@if (showDeleteConfirm)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:1050;display:flex;align-items:center;justify-content:center;">
        <div class="card" style="max-width:420px;width:90%;z-index:1055;">
            <div class="card-body p-4">
                <h5 class="card-title mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Delete Category?</h5>
                <p class="text-secondary mb-4">Are you sure you want to delete <strong>@deleteTargetLabel</strong>? This action cannot be undone.</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-danger flex-grow-1" @onclick="ExecuteDelete">
                        <i class="bi bi-trash me-1"></i> Yes, Delete
                    </button>
                    <button class="btn btn-light" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Category>? categories;
    private string? userId;
    private string? errorMessage;

    private bool showDeleteConfirm = false;
    private int deleteTargetId = 0;
    private string deleteTargetLabel = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            await LoadCategories();
        }
    }

    private async Task LoadCategories()
    {
        categories = await DbContext.Categories
            .Where(c => c.UserId == userId)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private void ConfirmDelete(int id, string name)
    {
        deleteTargetId = id;
        deleteTargetLabel = name;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteTargetId = 0;
    }

    private async Task ExecuteDelete()
    {
        showDeleteConfirm = false;
        try
        {
            var category = await DbContext.Categories.FindAsync(deleteTargetId);
            if (category != null && category.UserId == userId)
            {
                var hasTransactions = await DbContext.Transactions.AnyAsync(t => t.CategoryId == deleteTargetId);
                if (hasTransactions)
                {
                    errorMessage = $"Cannot delete \"{category.Name}\" because it has linked transactions. Please delete those transactions first.";
                    deleteTargetId = 0;
                    return;
                }

                DbContext.Categories.Remove(category);
                await DbContext.SaveChangesAsync();
                await LoadCategories();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete category: {ex.Message}";
        }
        deleteTargetId = 0;
    }
}
