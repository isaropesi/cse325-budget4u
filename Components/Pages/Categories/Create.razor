@page "/categories/create"
@using Microsoft.EntityFrameworkCore
@using budget4u.Data
@using budget4u.Data.Models
@using System.Security.Claims
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>New Category - Budget4U</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h2 class="card-title h4 mb-4">Create New Category</h2>

                <EditForm Model="category" OnValidSubmit="HandleSubmit" FormName="createCategory">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="mb-3">
                        <label for="name" class="form-label fw-medium">Category Name</label>
                        <InputText id="name" class="form-control form-control-lg" @bind-Value="category.Name" placeholder="e.g. Groceries" />
                        <ValidationMessage For="() => category.Name" class="text-danger mt-1 small" />
                    </div>

                    <div class="mb-3">
                        <label for="type" class="form-label fw-medium">Type</label>
                        <InputSelect id="type" class="form-select form-select-lg" @bind-Value="category.Type">
                            <option value="Expense">Expense</option>
                            <option value="Income">Income</option>
                        </InputSelect>
                        <ValidationMessage For="() => category.Type" class="text-danger mt-1 small" />
                    </div>

                    <div class="mb-4">
                        <label for="limit" class="form-label fw-medium">Monthly Budget Limit ($)</label>
                        <InputNumber id="limit" class="form-control form-control-lg" @bind-Value="category.BudgetLimit" placeholder="0.00" onfocus="this.select()" />
                        <ValidationMessage For="() => category.BudgetLimit" class="text-danger mt-1 small" />
                        <div class="form-text">Set 0 for income or if you don't want to track a limit.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Save Category</button>
                        <a href="/categories" class="btn btn-light btn-lg">Cancel</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Category category { get; set; } = new Category();

    private async Task HandleSubmit()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            category.UserId = userId;
            DbContext.Categories.Add(category);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo("/categories");
        }
    }
}
