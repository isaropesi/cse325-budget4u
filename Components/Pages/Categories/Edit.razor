@page "/categories/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using budget4u.Data
@using budget4u.Data.Models
@using System.Security.Claims
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Edit Category - Budget4U</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h2 class="card-title h4 mb-4">Edit Category</h2>

                @if (errorMessage != null)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    </div>
                }

                @if (category == null && errorMessage == null)
                {
                    <div class="text-center py-4 text-secondary">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p>Loading category...</p>
                    </div>
                }
                else if (category != null)
                {
                    <EditForm Model="category" OnValidSubmit="HandleSubmit" FormName="editCategory">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label for="name" class="form-label fw-medium">Category Name</label>
                            <InputText id="name" class="form-control form-control-lg" @bind-Value="category.Name" placeholder="e.g. Groceries" />
                            <ValidationMessage For="() => category.Name" class="text-danger mt-1 small" />
                        </div>

                        <div class="mb-3">
                            <label for="type" class="form-label fw-medium">Type</label>
                            <InputSelect id="type" class="form-select form-select-lg" @bind-Value="category.Type">
                                <option value="Expense">Expense</option>
                                <option value="Income">Income</option>
                            </InputSelect>
                            <ValidationMessage For="() => category.Type" class="text-danger mt-1 small" />
                        </div>

                        <div class="mb-4">
                            <label for="limit" class="form-label fw-medium">Monthly Budget Limit ($)</label>
                            <InputNumber id="limit" class="form-control form-control-lg" @bind-Value="category.BudgetLimit" placeholder="0.00" onfocus="this.select()" />
                            <ValidationMessage For="() => category.BudgetLimit" class="text-danger mt-1 small" />
                            <div class="form-text">Set 0 for income or if you don't want to track a limit.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a href="/categories" class="btn btn-light btn-lg">Cancel</a>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    private Category? category { get; set; }
    private string? userId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            if (category == null)
            {
                category = await DbContext.Categories
                    .FirstOrDefaultAsync(c => c.Id == Id && c.UserId == userId);

                if (category == null)
                {
                    errorMessage = "Category not found or you do not have permission to edit it.";
                }
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (userId != null && category != null)
        {
            try
            {
                category.Id = Id;
                category.UserId = userId;
                DbContext.Categories.Update(category);
                await DbContext.SaveChangesAsync();
                NavigationManager.NavigateTo("/categories");
            }
            catch (Exception ex)
            {
                errorMessage = $"An error occurred while saving: {ex.Message}";
            }
        }
    }
}
